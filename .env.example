# Copy to .env for local development. On Render these are set in the dashboard / render.yaml.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kbc?schema=public

# Optional: separate database used by `npm test` for the API integration test (it is wiped on each run)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kbc_test?schema=public

# Secret for signing session cookies. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First organizer account. Use ONE of these options:
# 1) Web setup page (/setup) protected by this token. Required in production for /setup to work.
SETUP_TOKEN=
# 2) Created automatically at startup if no organizer exists yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# How long a login lasts, in hours
SESSION_HOURS=12
